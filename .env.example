# Nothing reads this file on its own. Copy it to .env, fill in OPENAI_API_KEY
# and pass the file explicitly:
# uv run --no-sync --env-file .env text-to-sql-demo serve
TEXT_TO_SQL_DEMO_MODEL=gpt-6-luna
# none: gpt-6-luna takes tools on the Chat Completions API only without reasoning.
TEXT_TO_SQL_DEMO_REASONING_EFFORT=none
OPENAI_API_KEY=
TEXT_TO_SQL_DEMO_DATA_DIR=data
# Empty: the memory goes to memories/ in TEXT_TO_SQL_DEMO_DATA_DIR, and your own skills
# are read from skills/ in TEXT_TO_SQL_DEMO_DATA_DIR. When set, TEXT_TO_SQL_DEMO_SKILLS_DIR must be
# a folder that exists.
TEXT_TO_SQL_DEMO_MEMORY_DIR=
TEXT_TO_SQL_DEMO_SKILLS_DIR=
TEXT_TO_SQL_DEMO_MAX_ROWS=200
TEXT_TO_SQL_DEMO_QUERY_TIMEOUT_MS=5000
TEXT_TO_SQL_DEMO_WEB_DIST=web/dist
# Address of a nodeartifact server (nodeartifact serve) to send traces to; empty
# means no tracing.
TEXT_TO_SQL_DEMO_OTLP_ENDPOINT=
